{
  "name": "@velocut/mcp",
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/cli.cjs",
    "prepack": "node ../../scripts/validate-package.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "esbuild": "^0.28.2",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.5.4",
    "@velocut/protocol": "0.0.1"
  },
  "bin": {
    "velocut-mcp": "./dist/cli.cjs"
  },
  "files": [
    "dist/*.cjs",
    "dist/*.txt",
    "LICENSE",
    "README.md",
    "dist/licenses"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.6"
  },
  "exports": {
    ".": {
      "import": "./dist/server.cjs",
      "default": "./dist/server.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-ribbi/velocut.git",
    "directory": "web/packages/mcp"
  }
}
