{
  "name": "velocut-web",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm -w velocut-editor run dev",
    "build": "npm -w velocut-editor run build",
    "test": "node --experimental-strip-types --test 'packages/**/test/*.test.ts' && npm run test:codex-plugin",
    "e2e": "playwright test",
    "build:codex-plugin": "npm -w @velocut/codex-bridge run build",
    "test:codex-plugin": "npm run build:codex-plugin && node --test 'packages/codex-bridge/test/*.test.mjs'"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
